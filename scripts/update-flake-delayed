#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: update-flake-delayed [OPTIONS] <input> <owner> <repo> [branch]

Update a Nix flake input to a commit that is at least N days old.

Arguments:
  input     Flake input name (e.g. nixpkgs)
  owner     GitHub repository owner (e.g. NixOS)
  repo      GitHub repository name (e.g. nixpkgs)
  branch    Git branch (default: main)

Options:
  -d, --days N      Minimum age in days (default: 3)
  -n, --dry-run     Show what would be updated without applying
  -h, --help        Show this help

Examples:
  update-flake-delayed nixpkgs NixOS nixpkgs nixpkgs-unstable
  update-flake-delayed -d 7 home-manager nix-community home-manager
  update-flake-delayed --dry-run nixpkgs NixOS nixpkgs nixpkgs-unstable
USAGE
}

days=3
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--days)   days="$2"; shift 2 ;;
    -n|--dry-run) dry_run=true; shift ;;
    -h|--help)   usage; exit 0 ;;
    -*)          echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    *)           break ;;
  esac
done

if [[ $# -lt 3 ]]; then
  usage >&2
  exit 1
fi

input="$1"
owner="$2"
repo="$3"
branch="${4:-main}"

# macOS date uses -v, GNU date uses -d
if date -v-1d >/dev/null 2>&1; then
  cutoff=$(date -u -v-${days}d +%Y-%m-%dT%H:%M:%SZ)
else
  cutoff=$(date -u -d "${days} days ago" +%Y-%m-%dT%H:%M:%SZ)
fi

echo "Looking for ${owner}/${repo} (branch: ${branch}) commits before ${cutoff}..."

commit_data=$(gh api "repos/${owner}/${repo}/commits?sha=${branch}&until=${cutoff}&per_page=1" --jq '.[0] | {sha: .sha, date: .commit.committer.date, message: .commit.message}' 2>/dev/null)

sha=$(echo "$commit_data" | jq -r '.sha // empty')
commit_date=$(echo "$commit_data" | jq -r '.date // empty')
message=$(echo "$commit_data" | jq -r '.message // empty' | head -1)

if [[ -z "$sha" ]]; then
  echo "No commit found older than ${days} days on branch ${branch}"
  exit 1
fi

echo "Found: ${sha:0:12} (${commit_date})"
echo "  ${message}"

# Check current revision
current_rev=$(nix flake metadata --json --no-write-lock-file 2>/dev/null | jq -r ".locks.nodes.\"${input}\".locked.rev // \"unknown\"")

if [[ "${sha:0:40}" == "${current_rev:0:40}" ]]; then
  echo "Already at this revision. Nothing to do."
  exit 0
fi

echo "Current: ${current_rev:0:12}"
echo "Target:  ${sha:0:12}"

if [[ "$dry_run" == "true" ]]; then
  echo "(dry-run) Would run: nix flake update ${input} --override-input ${input} github:${owner}/${repo}/${sha}"
  exit 0
fi

nix flake update "$input" --override-input "$input" "github:${owner}/${repo}/${sha}"
echo "Updated ${input} to ${sha:0:12}"
